    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "1.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
